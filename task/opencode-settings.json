{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "curl * | sh*": "deny",
      "curl * | bash*": "deny",
      "wget * | sh*": "deny",
      "wget * | bash*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git config --global*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "chmod -R 777*": "deny",
      ":(){ :|:& };:*": "deny"
    },
    "read": {
      "*": "allow",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/*.pem": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "/etc/opencode/**": "deny"
    }
  }
}
