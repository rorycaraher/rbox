#!/usr/bin/env bash
#MISE description="Encrypt infra/secrets.yaml to infra/secrets.enc.yaml and remove the plaintext"
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../../infra"

if [[ ! -f secrets.yaml ]]; then
  echo "infra/secrets.yaml not found — copy secrets.yaml.example to secrets.yaml and fill it in first." >&2
  exit 1
fi

sops -e secrets.yaml > secrets.enc.yaml
rm secrets.yaml
echo "Encrypted -> infra/secrets.enc.yaml (commit this). infra/secrets.yaml removed." >&2
