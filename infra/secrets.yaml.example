# Template only — never fill this in and commit it as-is.
#
# Copy to secrets.yaml, fill in real values sourced from the Hetzner
# console (see RUNBOOK.md), then encrypt it:
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml
#   sops -e secrets.yaml > secrets.enc.yaml
#   rm secrets.yaml
#
# Only secrets.enc.yaml (ciphertext) gets committed. secrets.yaml
# (plaintext) is gitignored so it can't be committed by accident.

HCLOUD_TOKEN: "<hetzner cloud api token>"
AWS_ACCESS_KEY_ID: "<cloudflare r2 api token access key id>"
AWS_SECRET_ACCESS_KEY: "<cloudflare r2 api token secret access key>"
RBOX_TAILSCALE_IP: "<task host's tailscale ipv4 -- see RUNBOOK.md step 8b>"
